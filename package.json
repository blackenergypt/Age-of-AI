{
  "name": "age-of-ai",
  "version": "2.0.0",
  "private": true,
  "description": "Age of AI monorepo — web, panel, api, game-server",
  "scripts": {
    "dev": "pnpm run --parallel --filter @age-of-ai/api --filter @age-of-ai/game-server --filter @age-of-ai/web --filter @age-of-ai/panel dev",
    "dev:api": "pnpm --filter @age-of-ai/api dev",
    "dev:game": "pnpm --filter @age-of-ai/game-server dev",
    "dev:game:2": "GAME_SERVER_PORT=3003 GAME_NODE_ID=gs-2 GAME_SERVER_PUBLIC_WS_URL=ws://localhost:3003 pnpm --filter @age-of-ai/game-server start",
    "dev:web": "pnpm --filter @age-of-ai/web dev",
    "dev:panel": "pnpm --filter @age-of-ai/panel dev",
    "start:api": "pnpm --filter @age-of-ai/api start",
    "start:game": "pnpm --filter @age-of-ai/game-server start",
    "start:web": "pnpm --filter @age-of-ai/web start",
    "start:panel": "pnpm --filter @age-of-ai/panel start",
    "test-client": "node apps/game-server/test-client.js",
    "legacy:start": "node start.js"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "canvas"
    ]
  }
}
